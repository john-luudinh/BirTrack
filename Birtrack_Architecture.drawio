  <diagram id="p1_overall" name="1. BiRTrack Overall Architecture">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="1320" math="1" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="cell_2" value="&lt;div style=&quot;font-size: 22px; font-weight: bold; color: #0F172A; margin-bottom: 4px;&quot;&gt;BiRTrack: Reparameterized Bidirectional Local-Global Refiner &amp;amp; Search-Aware Adaptive Distillation&lt;/div&gt;&lt;div style=&quot;font-size: 13px; color: #334155;&quot;&gt;End-to-End UAV Tracking Architecture: Single-Stream ViT (l=8) &amp;bull; Structural Reparameterization (Rep-BLGR) &amp;bull; Zero-Inference Training (SA-ORR &amp;amp; MI-AFKD) &amp;bull; 285+ FPS on RTX / 75+ FPS on Orin Nano&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="2280" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="cell_3" value="&lt;b&gt;1. INPUTS &amp;amp; PATCH EMBEDDING&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=14;fontColor=#1E3A8A;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="145" width="400" height="1130" as="geometry"/>
        </mxCell>
        <mxCell id="cell_4" value="&lt;b&gt;Template Image Z&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;B &amp;times; 3 &amp;times; 128 &amp;times; 128&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#2563EB;&quot;&gt;Target Crop (Frame 0 or Reference)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=12;fontColor=#1E40AF;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="200" width="340" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cell_5" value="&lt;b&gt;Search Image X&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;B &amp;times; 3 &amp;times; 256 &amp;times; 256&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#059669;&quot;&gt;Current Frame Search Region&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;strokeWidth=2;fontSize=12;fontColor=#065F46;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="330" width="340" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="cell_6" value="&lt;b&gt;Patch Embedding (Z)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Conv2d(3, 192, k=16, s=16)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#1E40AF;&quot;&gt;Tokens: K&lt;sub&gt;z&lt;/sub&gt; = 64 &amp;times; 192&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=12;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="470" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cell_7" value="&lt;b&gt;Patch Embedding (X)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; color:#475569;&quot;&gt;Conv2d(3, 192, k=16, s=16)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#059669;&quot;&gt;Tokens: K&lt;sub&gt;x&lt;/sub&gt; = 256 &amp;times; 192&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=12;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="580" width="340" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cell_8" value="&lt;b&gt;Add Learnable Position Embeddings&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;Pos_Emb_Z: [1, 64, 192]&lt;br&gt;Pos_Emb_X: [1, 256, 192]&lt;br&gt;+ Pos_Dropout(p=0.0)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#92400E;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="690" width="340" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="cell_9" value="&lt;b&gt;Concat Tokens [Z, X]&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px; font-weight:bold; color:#1E293B;&quot;&gt;Tensor: [B, 320, 192]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#64748B;&quot;&gt;Unified Single-Stream Sequence&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=2;fontSize=11;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="810" width="340" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="cell_10" value="&lt;b&gt;Key Engineering Property:&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left; font-size:10px; line-height:1.4; color:#334155; margin-top:4px;&quot;&gt;&amp;bull; Fixed patch size: 16 &amp;times; 16&lt;br&gt;&amp;bull; No dynamic sequence lengths&lt;br&gt;&amp;bull; Constant memory stride&lt;br&gt;&amp;bull; Zero unstructured RAM access&lt;br&gt;&amp;bull; 100% deterministic static tensor shapes&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;fontSize=11;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="920" width="340" height="150" as="geometry"/>
        </mxCell>
