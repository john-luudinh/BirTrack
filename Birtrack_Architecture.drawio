        <mxCell id="cell_33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;" edge="1" parent="1" source="cell_23" target="cell_24">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cell_34" value="&lt;b&gt;3. REP-BLGR REFINER (APPLIED ON SEARCH TOKENS)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;strokeWidth=2;fontSize=14;fontColor=#B45309;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="145" width="680" height="1130" as="geometry"/>
        </mxCell>
        <mxCell id="cell_35" value="&lt;b&gt;Input 2D Feature Map: F&lt;sub&gt;search&lt;/sub&gt; [B, 192, 16, 16] &amp;rarr; GroupNorm(1, 192)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;strokeWidth=1.5;fontSize=11;fontColor=#92400E;" vertex="1" parent="cell_34">
          <mxGeometry x="980" y="200" width="620" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_36" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;" vertex="1" parent="cell_34">
          <mxGeometry x="980" y="270" width="620" height="310" as="geometry"/>
        </mxCell>
        <mxCell id="cell_37" value="&lt;b&gt;Training Phase (deploy=False)&lt;/b&gt;" style="rounded=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;fontColor=#1E40AF;" vertex="1" parent="cell_36">
          <mxGeometry x="990" y="280" width="290" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cell_38" value="&lt;b&gt;Inference Phase (deploy=True)&lt;/b&gt;" style="rounded=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=1;fontSize=11;fontColor=#065F46;" vertex="1" parent="cell_36">
          <mxGeometry x="1300" y="280" width="290" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cell_39" value="&lt;b&gt;Branch 1:&lt;/b&gt; Conv2d(5&amp;times;5, g=192, no bias) + BN" style="rounded=1;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=1;fontSize=10;" vertex="1" parent="cell_36">
          <mxGeometry x="990" y="320" width="290" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_40" value="&lt;b&gt;Branch 2:&lt;/b&gt; Conv2d(3&amp;times;3, g=192, no bias) + BN" style="rounded=1;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=1;fontSize=10;" vertex="1" parent="cell_36">
          <mxGeometry x="990" y="380" width="290" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_41" value="&lt;b&gt;Branch 3:&lt;/b&gt; Identity Connection + BN" style="rounded=1;fillColor=#DBEAFE;strokeColor=#60A5FA;strokeWidth=1;fontSize=10;" vertex="1" parent="cell_36">
          <mxGeometry x="990" y="440" width="290" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cell_42" value="&lt;b&gt;Linear Addition &amp;oplus; &amp;rarr; F&lt;sub&gt;local&lt;/sub&gt;&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#475569;&quot;&gt;Multi-scale receptive fields (5&amp;times;5, 3&amp;times;3, 1&amp;times;1)&lt;br&gt;capture small UAV targets under high scale shifts&lt;/span&gt;" style="rounded=1;fillColor=#E0E7FF;strokeColor=#6366F1;strokeWidth=1.5;fontSize=10;" vertex="1" parent="cell_36">
          <mxGeometry x="990" y="495" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cell_43" value="&lt;b&gt;Single Equivalent DWConv 5&amp;times;5 Layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#065F46;&quot;&gt;W&lt;sub&gt;equiv&lt;/sub&gt; = W&lt;sub&gt;5&lt;/sub&gt;&lt;sup&gt;fused&lt;/sup&gt; + Pad(W&lt;sub&gt;3&lt;/sub&gt;&lt;sup&gt;fused&lt;/sup&gt;) + Pad(W&lt;sub&gt;id&lt;/sub&gt;&lt;sup&gt;fused&lt;/sup&gt;)&lt;br&gt;b&lt;sub&gt;equiv&lt;/sub&gt; = b&lt;sub&gt;5&lt;/sub&gt;&lt;sup&gt;fused&lt;/sup&gt; + b&lt;sub&gt;3&lt;/sub&gt;&lt;sup&gt;fused&lt;/sup&gt; + b&lt;sub&gt;id&lt;/sub&gt;&lt;sup&gt;fused&lt;/sup&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;&amp;check; 0 Extra FLOPs &amp;bull; Single Memory Read&lt;/b&gt;" style="rounded=1;fillColor=#D1FAE5;strokeColor=#10B981;strokeWidth=2;fontSize=11;fontColor=#065F46;" vertex="1" parent="cell_36">
          <mxGeometry x="1300" y="340" width="290" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="cell_44" value="&lt;b&gt;switch_to_deploy() Execution&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#475569;&quot;&gt;Executed once before benchmark/runtime.&lt;br&gt;Training branches permanently deleted.&lt;/span&gt;" style="rounded=1;fillColor=#FEF9C3;strokeColor=#CA8A04;strokeWidth=1.5;fontSize=10;" vertex="1" parent="cell_36">
          <mxGeometry x="1300" y="495" width="290" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cell_45" value="&lt;b&gt;Local Self-Modulation:&lt;/b&gt; F&lt;sub&gt;local_mod&lt;/sub&gt; = SiLU(F&lt;sub&gt;local&lt;/sub&gt;) = F&lt;sub&gt;local&lt;/sub&gt; &amp;odot; &amp;sigma;(F&lt;sub&gt;local&lt;/sub&gt;)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#A855F7;strokeWidth=1.5;fontSize=11;fontColor=#581C87;" vertex="1" parent="cell_34">
          <mxGeometry x="980" y="600" width="620" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_46" value="&lt;b&gt;Global Context Extraction (FASA / Lightweight SE)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px; color:#475569; margin-top:2px;&quot;&gt;&amp;bull; Spatial Downsample: Conv2d(k=5, s=2) &amp;rarr; Feature Map [B, 192, 8, 8]&lt;br&gt;&amp;bull; Cross Attention: Softmax(Q &amp;bull; K&lt;sup&gt;T&lt;/sup&gt; / &amp;radic;d) &amp;bull; V &amp;rarr; F&lt;sub&gt;global&lt;/sub&gt; [B, 192, 16, 16]&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_34">
          <mxGeometry x="980" y="670" width="620" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="cell_47" value="&lt;b&gt;Bidirectional Cross-Modulation Gate&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px; color:#92400E; margin-top:2px;&quot;&gt;F&lt;sub&gt;local&lt;/sub&gt;&lt;sup&gt;&amp;prime;&lt;/sup&gt; = F&lt;sub&gt;local_mod&lt;/sub&gt; &amp;odot; &amp;sigma;(F&lt;sub&gt;global&lt;/sub&gt;) &amp;nbsp;&amp;nbsp;|&amp;nbsp;&amp;nbsp; F&lt;sub&gt;global&lt;/sub&gt;&lt;sup&gt;&amp;prime;&lt;/sup&gt; = F&lt;sub&gt;global&lt;/sub&gt; &amp;odot; &amp;sigma;(F&lt;sub&gt;local_mod&lt;/sub&gt;)&lt;br&gt;&lt;b&gt;F&lt;sub&gt;bidir&lt;/sub&gt; = F&lt;sub&gt;local&lt;/sub&gt;&lt;sup&gt;&amp;prime;&lt;/sup&gt; &amp;odot; F&lt;sub&gt;global&lt;/sub&gt;&lt;sup&gt;&amp;prime;&lt;/sup&gt;&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=11;" vertex="1" parent="cell_34">
          <mxGeometry x="980" y="770" width="620" height="80" as="geometry"/>
