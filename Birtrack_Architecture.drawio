        <mxCell id="cell_59" value="&lt;b&gt;Offset Map (o)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;[B, 2, 16, 16]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:9px; color:#B91C1C;&quot;&gt;Sub-pixel center compensation (&amp;delta;x, &amp;delta;y)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_55">
