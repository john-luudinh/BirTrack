        <mxCell id="cell_57" value="&lt;b&gt;Prediction Head Backbone (4 &amp;times; Conv-BN-ReLU)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;4 sequential layers with 256 channels &amp;bull; Preserves high-frequency spatial gradients&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F87171;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_55">
