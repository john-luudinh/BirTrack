        <mxCell id="cell_55" value="&lt;b&gt;4. PREDICTION HEAD &amp;amp; OUTPUTS&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;strokeWidth=2;fontSize=14;fontColor=#991B1B;rounded=1;shadow=1;" vertex="1" parent="1">
