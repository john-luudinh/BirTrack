          <mxGeometry x="70" y="400" width="620" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="cell_8" value="&lt;b&gt;RepLocalBranch: 3 Parallel Multi-Scale Operators&lt;/b&gt;" style="rounded=1;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;fontColor=#1D4ED8;" vertex="1" parent="cell_7">
          <mxGeometry x="80" y="410" width="600" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="cell_9" value="&lt;b&gt;Branch 5&amp;times;5:&lt;/b&gt; Conv2d(192, 192, k=5, p=2, groups=192) + BatchNorm2d(192)" style="rounded=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=10;" vertex="1" parent="cell_7">
          <mxGeometry x="90" y="445" width="580" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cell_10" value="&lt;b&gt;Branch 3&amp;times;3:&lt;/b&gt; Conv2d(192, 192, k=3, p=1, groups=192) + BatchNorm2d(192)" style="rounded=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=10;" vertex="1" parent="cell_7">
          <mxGeometry x="90" y="500" width="580" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cell_11" value="&lt;b&gt;Branch Identity:&lt;/b&gt; BatchNorm2d(192) (Implicit 1&amp;times;1 Identity Matrix)" style="rounded=1;fillColor=#DBEAFE;strokeColor=#3B82F6;strokeWidth=1;fontSize=10;" vertex="1" parent="cell_7">
          <mxGeometry x="90" y="555" width="580" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="cell_12" value="&lt;b&gt;Element-wise Sum:&lt;/b&gt; Branch_5&amp;times;5(Q) + Branch_3&amp;times;3(Q) + Branch_ID(Q)" style="rounded=1;fillColor=#BFDBFE;strokeColor=#1D4ED8;strokeWidth=1.5;fontSize=10;" vertex="1" parent="cell_7">
          <mxGeometry x="90" y="600" width="580" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="cell_13" value="&lt;b&gt;SiLU Self-Modulation:&lt;/b&gt; F&lt;sub&gt;local&lt;/sub&gt; = SiLU(Local_Sum)" style="rounded=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="660" width="620" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cell_14" value="&lt;b&gt;Global Branch (FASA Adaptive Self-Attention)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;&amp;bull; Refined Downsampling: Conv2d(k=5, s=2) + BN &amp;rarr; Pool to [B, 192, 8, 8]&lt;br&gt;&amp;bull; KV Projection: Conv2d(192, 384, k=1)&lt;br&gt;&amp;bull; Scaled Dot-Product: Softmax(Q &amp;bull; K&lt;sup&gt;T&lt;/sup&gt; / &amp;radic;d) &amp;bull; V &amp;rarr; F&lt;sub&gt;global&lt;/sub&gt; [B, 192, 16, 16]&lt;/span&gt;" style="rounded=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="725" width="620" height="95" as="geometry"/>
        </mxCell>
        <mxCell id="cell_15" value="&lt;b&gt;Bidirectional Cross-Modulation:&lt;/b&gt;&lt;br&gt;F&lt;sub&gt;bidir&lt;/sub&gt; = [F&lt;sub&gt;local&lt;/sub&gt; &amp;odot; &amp;sigma;(F&lt;sub&gt;global&lt;/sub&gt;)] &amp;odot; [F&lt;sub&gt;global&lt;/sub&gt; &amp;odot; &amp;sigma;(F&lt;sub&gt;local&lt;/sub&gt;)]" style="rounded=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="840" width="620" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="cell_16" value="&lt;b&gt;Pointwise Mixer &amp;amp; Learnable Residual Connection:&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:bold;&quot;&gt;Output = X + &amp;gamma; &amp;times; Conv2d(192, 192, k=1)(F&lt;sub&gt;bidir&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontSize=11;" vertex="1" parent="cell_3">
