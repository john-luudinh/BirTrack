          <mxGeometry x="70" y="270" width="620" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="cell_6" value="&lt;b&gt;1&amp;times;1 Conv Query Projection: Q = Conv2d(192, 192, k=1)&lt;/b&gt;" style="rounded=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1;fontSize=11;" vertex="1" parent="cell_3">
          <mxGeometry x="70" y="335" width="620" height="45" as="geometry"/>
