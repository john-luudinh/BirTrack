          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cell_16" value="&lt;b&gt;2. STATIC ViT BACKBONE (l = 8 BLOCKS)&lt;/b&gt;" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=34;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;fillColor=#F5F3FF;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontColor=#5B21B6;rounded=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="145" width="450" height="1130" as="geometry"/>
        </mxCell>
        <mxCell id="cell_17" value="&lt;b&gt;Input Tokens: [B, 320, 192]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="200" width="390" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_18" value="&lt;b&gt;Transformer Block 1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;Pre-LN &amp;rarr; Multi-Head Self-Attention (MHSA, h=3) &amp;rarr; + Residual&lt;br&gt;Pre-LN &amp;rarr; MLP (192 &amp;rarr; 768 &amp;rarr; 192, GELU) &amp;rarr; + Residual&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="270" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cell_19" value="&lt;b&gt;Transformer Block 2&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;Joint Attention between Template &amp;amp; Search Tokens&lt;br&gt;Cross-correlation &amp;amp; feature extraction unified in 1 stream&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#A78BFA;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="380" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cell_20" value="&lt;b&gt;&amp;bull; &amp;bull; &amp;bull; (Blocks 3 to 7: Static Depth) &amp;bull; &amp;bull; &amp;bull;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF5FF;strokeColor=#C4B5FD;strokeWidth=1;dashed=1;fontSize=11;fontColor=#6B21A8;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="490" width="390" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_21" value="&lt;b&gt;Transformer Block 8 (Active Depth l=8)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#475569;&quot;&gt;Structured Trimming from Teacher (L=12 &amp;rarr; l=8)&lt;br&gt;Zero control flow (no if/else, no dynamic scatter/gather)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=2;fontSize=11;fontColor=#4C1D95;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="560" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cell_22" value="&lt;b&gt;Final LayerNorm(192)&lt;/b&gt; &amp;rarr; [B, 320, 192]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="670" width="390" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="cell_23" value="&lt;b&gt;Token Demultiplexer (Slice)&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;font-size:10px; margin-top:4px;&quot;&gt;&lt;span style=&quot;color:#2563EB;&quot;&gt;&amp;bull; tokens[:, :64, :] &amp;rarr; Template Tokens t&lt;sub&gt;z&lt;/sub&gt; [B, 64, 192]&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#059669;&quot;&gt;&amp;bull; tokens[:, 64:, :] &amp;rarr; Search Tokens t&lt;sub&gt;x&lt;/sub&gt; [B, 256, 192]&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=2;fontSize=11;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="740" width="390" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="cell_24" value="&lt;b&gt;2D Feature Map Reshaping&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:bold; color:#0F172A;&quot;&gt;t&lt;sub&gt;x&lt;/sub&gt;.transpose(1, 2).view(B, 192, 16, 16)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;strokeWidth=2;fontSize=11;fontColor=#065F46;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="850" width="390" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cell_25" value="&lt;b&gt;Why Structured Trimming over Token Pruning?&lt;/b&gt;&lt;br&gt;&lt;div style=&quot;text-align:left; font-size:10px; line-height:1.4; color:#334155; margin-top:4px;&quot;&gt;&amp;bull; Aba-ViTrack token pruning alters tensor size &amp;rarr; GPU cache miss &amp;amp; memory bandwidth drop (23.6% latency surge).&lt;br&gt;&amp;bull; BiRTrack retains 100% static graph &amp;rarr; TensorRT executes seamless kernel fusion with Batch=1.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=1;fontSize=11;" vertex="1" parent="cell_16">
          <mxGeometry x="500" y="940" width="390" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="cell_26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;" edge="1" parent="1" source="cell_9" target="cell_17">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cell_27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;" edge="1" parent="1" source="cell_17" target="cell_18">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cell_28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;" edge="1" parent="1" source="cell_18" target="cell_19">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="cell_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=2;fontSize=11;fontColor=#1E293B;" edge="1" parent="1" source="cell_19" target="cell_20">
          <mxGeometry relative="1" as="geometry"/>
