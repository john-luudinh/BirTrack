        </mxCell>
        <mxCell id="cell_61" value="&lt;b&gt;Bounding Box Decoder:&lt;/b&gt; (x&lt;sub&gt;c&lt;/sub&gt;, y&lt;sub&gt;c&lt;/sub&gt;) = argmax(p) + o &amp;nbsp;&amp;bull;&amp;nbsp; (w, h) = s[x&lt;sub&gt;c&lt;/sub&gt;, y&lt;sub&gt;c&lt;/sub&gt;]&lt;br&gt;&lt;span style=&quot;font-size:12px; font-weight:bold; color:#047857;&quot;&gt;Final Predicted BBox: [x&lt;sub&gt;1&lt;/sub&gt;, y&lt;sub&gt;1&lt;/sub&gt;, x&lt;sub&gt;2&lt;/sub&gt;, y&lt;sub&gt;2&lt;/sub&gt;]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=11;fontColor=#065F46;" vertex="1" parent="cell_55">
          <mxGeometry x="1690" y="480" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="cell_62" value="&lt;b&gt;BiRTrack Performance vs State-of-the-Art Baselines&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;width:100%; border-collapse:collapse; font-size:10px; text-align:center; margin-top:6px;&quot; border=&quot;1&quot;&gt;&lt;tr style=&quot;background:#F1F5F9; font-weight:bold;&quot;&gt;&lt;td&gt;Model&lt;/td&gt;&lt;td&gt;Backbone&lt;/td&gt;&lt;td&gt;Params&lt;/td&gt;&lt;td&gt;FLOPs&lt;/td&gt;&lt;td&gt;FPS (RTX)&lt;/td&gt;&lt;td&gt;VisDrone Prec&lt;/td&gt;&lt;td&gt;UAV123 Succ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ORTrack&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ViT (L=12)&lt;/td&gt;&lt;td&gt;7.9M&lt;/td&gt;&lt;td&gt;2.40G&lt;/td&gt;&lt;td&gt;172.4&lt;/td&gt;&lt;td&gt;88.6%&lt;/td&gt;&lt;td&gt;68.2%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Aba-ViTrack&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Dynamic ViT&lt;/td&gt;&lt;td&gt;7.9M&lt;/td&gt;&lt;td&gt;1.80G&lt;/td&gt;&lt;td&gt;161.2 (RAM drop)&lt;/td&gt;&lt;td&gt;86.4%&lt;/td&gt;&lt;td&gt;67.0%&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;ORTrack-D&lt;/b&gt;&lt;/td&gt;&lt;td&gt;ViT (l=8)&lt;/td&gt;&lt;td&gt;5.3M&lt;/td&gt;&lt;td&gt;1.50G&lt;/td&gt;&lt;td&gt;292.3&lt;/td&gt;&lt;td&gt;84.6% (-4.0%)&lt;/td&gt;&lt;td&gt;65.8%&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#D1FAE5; font-weight:bold; color:#065F46;&quot;&gt;&lt;td&gt;&lt;b&gt;BiRTrack (Ours)&lt;/b&gt;&lt;/td&gt;&lt;td&gt;8 + Rep-BLGR&lt;/td&gt;&lt;td&gt;5.35M&lt;/td&gt;&lt;td&gt;1.52G&lt;/td&gt;&lt;td&gt;285+ FPS&lt;/td&gt;&lt;td&gt;88.2% (+3.6%)&lt;/td&gt;&lt;td&gt;68.0% (+2.2%)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style=&quot;text-align:left; font-size:9.5px; color:#334155; margin-top:8px;&quot;&gt;&amp;bull; Recovers 90%+ of the accuracy lost by layer trimming (+3.6% VisDrone Precision).&lt;br&gt;&amp;bull; Maintains ultra-high speed (285+ FPS) with zero runtime branching or dynamic buffers.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=11;" vertex="1" parent="cell_55">
