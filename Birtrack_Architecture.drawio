        <mxCell id="cell_2" value="&lt;div style=&quot;font-size: 22px; font-weight: bold; color: #0F172A; margin-bottom: 4px;&quot;&gt;Rep-BLGR: Structural Re-parameterization &amp;amp; Bidirectional Interaction Deep Dive&lt;/div&gt;&lt;div style=&quot;font-size: 13px; color: #334155;&quot;&gt;Algebraic Operator Fusion: 3-Branch Multi-Scale Training Topology Collapses to a Single 5&amp;times;5 Depthwise Convolutional Layer at Inference&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=2;shadow=1;" vertex="1" parent="1">
