        <mxCell id="cell_48" value="&lt;b&gt;Pointwise Mixer &amp;amp; Learnable Residual&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px; font-weight:bold; color:#0F172A;&quot;&gt;F&lt;sub&gt;refined&lt;/sub&gt; = F&lt;sub&gt;in&lt;/sub&gt; + &amp;gamma; &amp;times; Conv2d(1&amp;times;1)(F&lt;sub&gt;bidir&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px; color:#64748B;&quot;&gt;&amp;gamma; initialized to 0 for ultra-stable warmup&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontSize=11;" vertex="1" parent="cell_34">
